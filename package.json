{
  "name": "tclock",
  "version": "1.0.0",
  "description": "TClock - Ücretsiz flip clock masaüstü uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.tclock.app",
    "productName": "TClock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "opentype.js": "^2.0.0",
    "three": "^0.160.0"
  }
}
